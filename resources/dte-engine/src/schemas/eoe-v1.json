{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evento de Operaciones Especiales V1",
  "type": "object",
  "properties": {
    "identificacion": {
      "type": "object",
      "properties": {
        "version":          { "type": "integer", "const": 1 },
        "ambiente":         { "type": "string", "enum": ["00", "01"] },
        "codigoGeneracion": {
          "type": "string", "minLength": 36, "maxLength": 36,
          "pattern": "^[A-F0-9]{8}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{12}$"
        },
        "fecEmi": { "type": "string", "format": "date" },
        "horEmi": { "type": "string", "pattern": "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$" }
      },
      "required": ["version", "ambiente", "codigoGeneracion", "fecEmi", "horEmi"],
      "additionalProperties": false
    },
    "emisor": {
      "type": "object",
      "properties": {
        "nit":               { "type": "string", "pattern": "^([0-9]{14}|[0-9]{9})$" },
        "nrc":               { "type": ["string", "null"] },
        "nombre":            { "type": "string", "minLength": 3, "maxLength": 250 },
        "codActividad":      { "type": ["string", "null"] },
        "descActividad":     { "type": ["string", "null"] },
        "nombreComercial":   { "type": ["string", "null"] },
        "tipoEstablecimiento": { "type": "string", "enum": ["01", "02", "04", "07", "20"] },
        "direccion": {
          "type": "object",
          "properties": {
            "departamento": { "type": "string" },
            "municipio":    { "type": "string" },
            "complemento":  { "type": "string" }
          },
          "required": ["departamento", "municipio", "complemento"],
          "additionalProperties": false
        },
        "telefono":        { "type": ["string", "null"] },
        "correo":          { "type": "string", "format": "email" },
        "codEstableMH":    { "type": ["string", "null"] },
        "codEstable":      { "type": ["string", "null"] },
        "codPuntoVentaMH": { "type": ["string", "null"] },
        "codPuntoVenta":   { "type": ["string", "null"] }
      },
      "required": ["nit", "nombre", "tipoEstablecimiento", "direccion", "correo"],
      "additionalProperties": false
    },
    "receptor": {
      "type": ["object", "null"],
      "properties": {
        "nombre":      { "type": "string", "maxLength": 250 },
        "tipoPersona": { "type": ["integer", "null"], "enum": [null, 1, 2] },
        "codPais":     { "type": ["string", "null"] },
        "nombrePais":  { "type": ["string", "null"] },
        "complemento": { "type": ["string", "null"] },
        "telefono":    { "type": ["string", "null"] },
        "correo":      { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "detalleOperaciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "numItem":       { "type": "integer", "minimum": 1 },
          "tipoOperacion": { "type": "string", "enum": ["01", "02", "03"] },
          "descripcion":   { "type": "string", "minLength": 1, "maxLength": 1000 },
          "monto":         { "type": "number", "minimum": 0, "multipleOf": 0.01 },
          "observaciones": { "type": ["string", "null"], "maxLength": 3000 }
        },
        "required": ["numItem", "tipoOperacion", "descripcion", "monto"],
        "additionalProperties": false
      }
    },
    "resumen": {
      "type": "object",
      "properties": {
        "condicionOperacion": { "type": "integer", "enum": [1, 2, 3] },
        "montoTotal":         { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "totalLetras":        { "type": "string", "maxLength": 200 },
        "observaciones":      { "type": ["string", "null"], "maxLength": 3000 }
      },
      "required": ["condicionOperacion", "montoTotal"],
      "additionalProperties": false
    },
    "apendice": { "type": ["array", "null"] }
  },
  "required": ["identificacion", "emisor", "detalleOperaciones", "resumen"],
  "additionalProperties": false
}
