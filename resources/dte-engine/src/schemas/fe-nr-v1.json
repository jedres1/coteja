{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nota de Remisión V1",
  "type": "object",
  "properties": {
    "identificacion": {
      "type": "object",
      "properties": {
        "version":           { "type": "integer", "const": 1 },
        "ambiente":          { "type": "string", "enum": ["00", "01"] },
        "tipoDte":           { "type": "string", "const": "04" },
        "numeroControl":     { "type": "string", "minLength": 31, "maxLength": 31, "pattern": "^DTE-04-[A-Z0-9]{8}-[0-9]{15}$" },
        "codigoGeneracion":  { "type": "string", "minLength": 36, "maxLength": 36, "pattern": "^[A-F0-9]{8}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{12}$" },
        "tipoModelo":        { "type": "number", "enum": [1, 2] },
        "tipoOperacion":     { "type": "integer", "enum": [1, 2] },
        "tipoContingencia":  { "type": ["integer", "null"], "enum": [null, 1, 2, 3, 4, 5] },
        "motivoContin":      { "type": ["string", "null"], "maxLength": 150 },
        "fecEmi":            { "type": "string", "format": "date" },
        "horEmi":            { "type": "string", "pattern": "^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$" },
        "tipoMoneda":        { "type": "string", "const": "USD" }
      },
      "required": ["version", "ambiente", "tipoDte", "numeroControl", "codigoGeneracion", "tipoModelo", "tipoOperacion", "fecEmi", "horEmi", "tipoMoneda"],
      "additionalProperties": false
    },
    "documentoRelacionado": { "type": ["array", "null"] },
    "emisor": {
      "type": "object",
      "properties": {
        "nit":               { "type": "string" },
        "nrc":               { "type": "string" },
        "nombre":            { "type": "string", "minLength": 3, "maxLength": 250 },
        "codActividad":      { "type": ["string", "null"] },
        "descActividad":     { "type": ["string", "null"] },
        "nombreComercial":   { "type": ["string", "null"] },
        "tipoEstablecimiento": { "type": "string", "enum": ["01", "02", "04", "07", "20"] },
        "direccion": {
          "type": "object",
          "properties": {
            "departamento": { "type": "string" },
            "municipio":    { "type": "string" },
            "complemento":  { "type": "string" }
          },
          "required": ["departamento", "municipio", "complemento"],
          "additionalProperties": false
        },
        "telefono":          { "type": ["string", "null"] },
        "correo":            { "type": "string" },
        "codEstableMH":      { "type": ["string", "null"] },
        "codEstable":        { "type": ["string", "null"] },
        "codPuntoVentaMH":   { "type": ["string", "null"] },
        "codPuntoVenta":     { "type": ["string", "null"] }
      },
      "required": ["nit", "nrc", "nombre", "tipoEstablecimiento", "direccion", "correo"],
      "additionalProperties": false
    },
    "receptor": {
      "type": "object",
      "properties": {
        "nit":             { "type": ["string", "null"] },
        "nrc":             { "type": ["string", "null"] },
        "nombre":          { "type": "string", "minLength": 3, "maxLength": 250 },
        "codActividad":    { "type": ["string", "null"] },
        "descActividad":   { "type": ["string", "null"] },
        "nombreComercial": { "type": ["string", "null"] },
        "direccion": {
          "type": ["object", "null"],
          "properties": {
            "departamento": { "type": "string" },
            "municipio":    { "type": "string" },
            "complemento":  { "type": "string" }
          },
          "additionalProperties": false
        },
        "telefono":        { "type": ["string", "null"] },
        "correo":          { "type": ["string", "null"] }
      },
      "required": ["nombre"],
      "additionalProperties": false
    },
    "otrosDocumentos": { "type": ["array", "null"] },
    "ventaTercero":    { "type": ["object", "null"] },
    "cuerpoDocumento": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "numItem":        { "type": "integer", "minimum": 1 },
          "tipoItem":       { "type": "integer", "enum": [1, 2, 3, 4] },
          "numeroDocumento":{ "type": ["string", "null"] },
          "cantidad":       { "type": "number", "exclusiveMinimum": 0 },
          "codigo":         { "type": ["string", "null"] },
          "codTributo":     { "type": ["string", "null"] },
          "uniMedida":      { "type": "integer" },
          "descripcion":    { "type": "string", "minLength": 1, "maxLength": 1000 },
          "precioUni":      { "type": "number", "minimum": 0 },
          "montoDescu":     { "type": "number", "minimum": 0 },
          "ventaNoSuj":     { "type": "number", "minimum": 0 },
          "ventaExenta":    { "type": "number", "minimum": 0 },
          "ventaGravada":   { "type": "number", "minimum": 0 },
          "tributos":       { "type": ["array", "null"] },
          "psv":            { "type": "number" },
          "noGravado":      { "type": "number" }
        },
        "required": ["numItem", "tipoItem", "cantidad", "uniMedida", "descripcion", "precioUni", "montoDescu", "ventaNoSuj", "ventaExenta", "ventaGravada"],
        "additionalProperties": false
      }
    },
    "resumen": {
      "type": "object",
      "properties": {
        "totalNoSuj":           { "type": "number", "minimum": 0 },
        "totalExenta":          { "type": "number", "minimum": 0 },
        "totalGravada":         { "type": "number", "minimum": 0 },
        "subTotalVentas":       { "type": "number", "minimum": 0 },
        "descuNoSuj":           { "type": "number", "minimum": 0 },
        "descuExenta":          { "type": "number", "minimum": 0 },
        "descuGravada":         { "type": "number", "minimum": 0 },
        "porcentajeDescuento":  { "type": "number", "minimum": 0 },
        "totalDescu":           { "type": "number", "minimum": 0 },
        "tributos":             { "type": ["array", "null"] },
        "subTotal":             { "type": "number", "minimum": 0 },
        "ivaRete1":             { "type": "number", "minimum": 0 },
        "ivaPerci1":            { "type": "number", "minimum": 0 },
        "reteRenta":            { "type": "number", "minimum": 0 },
        "montoTotalOperacion":  { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "totalNoGravado":       { "type": "number", "minimum": 0 },
        "totalPagar":           { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "totalLetras":          { "type": "string", "maxLength": 200 },
        "saldoFavor":           { "type": "number", "minimum": 0 },
        "condicionOperacion":   { "type": "integer", "enum": [1, 2, 3] },
        "pagos":                { "type": ["array", "null"] },
        "numPagoElectronico":   { "type": ["string", "null"] }
      },
      "required": ["montoTotalOperacion", "totalPagar", "condicionOperacion"],
      "additionalProperties": false
    },
    "extension": { "type": ["object", "null"] },
    "apendice":  { "type": ["array", "null"] }
  },
  "required": ["identificacion", "emisor", "receptor", "cuerpoDocumento", "resumen"],
  "additionalProperties": false
}
